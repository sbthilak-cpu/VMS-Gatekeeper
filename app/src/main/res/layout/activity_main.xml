<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8F9FA">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gatekeeper Operations" android:textSize="22sp" android:textStyle="bold" android:textColor="#212529" android:layout_marginBottom="20dp" />
        <Button android:id="@+id/btnScanQR" android:layout_width="match_parent" android:layout_height="60dp" android:text="📷 Scan Visitor QR Pass" android:backgroundTint="#0D6EFD" android:textColor="#FFFFFF" android:textSize="16sp" android:layout_marginBottom="10dp" />
        <Button android:id="@+id/btnConfigureSite" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⚙️ Site Profiles Configuration" android:backgroundTint="#6C757D" android:textColor="#FFFFFF" android:layout_marginBottom="20dp" style="@style/Widget.MaterialComponents.Button.TextButton" />
        <TextView android:id="@+id/tvDisplayDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Standby Mode: Awaiting target scan capture..." android:background="#FFFFFF" android:padding="16dp" android:textColor="#495057" android:textSize="15sp" android:layout_marginBottom="20dp" />
        <LinearLayout android:id="@+id/layoutMaterialSubForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#FFFFFF" android:padding="16dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Material/Asset Carriage Logs" android:textStyle="bold" android:textColor="#0D6EFD" android:layout_marginBottom="12dp" />
            <EditText android:id="@+id/etMaterialName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Item Description" android:inputType="text" android:layout_marginBottom="10dp" />
            <EditText android:id="@+id/etMaterialSerial" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Serial Number / Invoice" android:inputType="text" android:layout_marginBottom="16dp" />
            <Button android:id="@+id/btnCommitEntry" android:layout_width="match_parent" android:layout_height="50dp" android:text="Verify ^&amp; Check-In" android:backgroundTint="#198754" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
