<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="#F8F9FA">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="System Remote Configuration" android:textSize="18sp" android:textStyle="bold" android:textColor="#212529" android:layout_marginBottom="20dp" />
    <EditText android:id="@+id/etCompanyField" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Company Name" android:inputType="text" android:layout_marginBottom="14dp" />
    <EditText android:id="@+id/etSiteField" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Site Name" android:inputType="text" android:layout_marginBottom="14dp" />
    <EditText android:id="@+id/etAddressField" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Physical Address" android:inputType="textMultiLine" android:lines="3" android:layout_marginBottom="24dp" />
    <Button android:id="@+id/btnSaveConfig" android:layout_width="match_parent" android:layout_height="50dp" android:text="Push Global Update" android:backgroundTint="#198754" />
</LinearLayout>
